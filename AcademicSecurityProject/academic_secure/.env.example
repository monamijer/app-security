# === AcademicManager Secure — Variables d'environnement ===
SECRET_KEY=change-me-to-a-long-random-string-64-chars-min
JWT_SECRET_KEY=change-me-to-a-long-random-string-64-chars-min
JWT_ALGORITHM=HS256
JWT_ISSUER=academic-secure
JWT_AUDIENCE=academic-secure-clients
DATABASE_URL=sqlite:///academic_secure.db
FLASK_ENV=development
FLASK_DEBUG=0
UPLOAD_FOLDER=instance/uploads
MAX_CONTENT_LENGTH=5242880
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax